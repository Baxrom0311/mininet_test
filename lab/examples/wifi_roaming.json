{
  "version": 1,
  "name": "wifi_roaming",
  "meters_per_px": 0.25,
  "notes": "Ikki AP bitta ESS'da (SSID 'kampus', 36-kanal), 100 m oraliqda. mob1 ap1 dan ap2 ga yuradi: ap1 qamrovidan chiqqach (~70 m) ap2 ga roaming qiladi. Kabel ap1 ga ulangan — roaming esa avtomatik.",
  "devices": {
    "s1": {
      "id": 1,
      "type": "switch",
      "x": 500,
      "y": 560,
      "config": {
        "mode": "standalone",
        "stp": false,
        "controller": ""
      }
    },
    "srv1": {
      "id": 2,
      "type": "server",
      "x": 500,
      "y": 700,
      "config": {
        "interfaces": {
          "srv1-eth1": {
            "ip": "10.0.0.10/24"
          }
        },
        "gateway": "",
        "routes": []
      }
    },
    "ap1": {
      "id": 3,
      "type": "wifiap",
      "x": 300,
      "y": 360,
      "config": {
        "standard": "80211ax",
        "band": 5,
        "width": 20,
        "tx_power": 20,
        "ssid": "kampus",
        "channel": 36
      }
    },
    "ap2": {
      "id": 4,
      "type": "wifiap",
      "x": 700,
      "y": 360,
      "config": {
        "standard": "80211ax",
        "band": 5,
        "width": 20,
        "tx_power": 20,
        "ssid": "kampus",
        "channel": 36
      }
    },
    "mob1": {
      "id": 5,
      "type": "host",
      "x": 330,
      "y": 300,
      "config": {
        "interfaces": {
          "mob1-eth1": {
            "ip": "10.0.0.31/24"
          }
        },
        "gateway": "",
        "routes": []
      }
    }
  },
  "links": {
    "l1": {
      "a": {
        "dev": "srv1",
        "port": 1
      },
      "b": {
        "dev": "s1",
        "port": 1
      },
      "params": {
        "bw": 1000,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000,
        "medium": "wire"
      },
      "up": true
    },
    "l2": {
      "a": {
        "dev": "ap1",
        "port": 1
      },
      "b": {
        "dev": "s1",
        "port": 2
      },
      "params": {
        "bw": 1000,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000,
        "medium": "wire"
      },
      "up": true
    },
    "l3": {
      "a": {
        "dev": "ap2",
        "port": 1
      },
      "b": {
        "dev": "s1",
        "port": 3
      },
      "params": {
        "bw": 1000,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000,
        "medium": "wire"
      },
      "up": true
    },
    "w1": {
      "a": {
        "dev": "mob1",
        "port": 1
      },
      "b": {
        "dev": "ap1",
        "port": 2
      },
      "params": {
        "bw": 100,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000,
        "medium": "wifi"
      },
      "up": true
    }
  },
  "p4_programs": {},
  "controllers": {},
  "scenarios": {
    "yurish": {
      "duration": 45,
      "apps": [
        {
          "id": "v",
          "type": "udp",
          "src": "srv1",
          "dst": "mob1",
          "rate": "20Mbps",
          "size": 1200,
          "start": 1,
          "stop": 44,
          "label": "video →mob1"
        },
        {
          "id": "p",
          "type": "ping",
          "src": "mob1",
          "dst": "srv1",
          "interval": 0.2,
          "start": 1,
          "stop": 44,
          "label": "ping mob1→srv1"
        }
      ],
      "events": [
        {
          "t": 5,
          "action": "move",
          "device": "mob1",
          "x": 680,
          "y": 300,
          "duration": 30
        }
      ],
      "notes": "mob1 t=5..35 s da ap1 dan ap2 ga yuradi — roaming paytida qisqa uzilish"
    }
  }
}