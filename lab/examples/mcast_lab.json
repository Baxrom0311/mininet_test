{
  "version": 1,
  "name": "mcast_lab",
  "notes": "IP multicast (IGMP + PIM-SM, RP = r1 10.0.0.1): srv1 239.1.1.1 guruhiga 4 Mbit/s video yuboradi; pc1 va pc3 a'zo, pc2 a'zo emas (s1 da IGMP snooping — pc2 portiga oqim chiqmaydi). r1-r3 uzilsa, OSPF yo'li r2 orqali, PIM daraxti qayta quriladi.",
  "p4_programs": {},
  "controllers": {},
  "devices": {
    "srv1": {
      "id": 1,
      "type": "server",
      "x": 80,
      "y": 240,
      "config": {
        "interfaces": {
          "srv1-eth1": {
            "ip": "10.0.0.10/24"
          }
        },
        "gateway": "10.0.0.1",
        "routes": []
      }
    },
    "r1": {
      "id": 2,
      "type": "router",
      "x": 260,
      "y": 240,
      "config": {
        "daemons": [
          "ospfd",
          "pimd"
        ],
        "interfaces": {
          "r1-eth1": {
            "ip": "10.0.0.1/24"
          },
          "r1-eth2": {
            "ip": "10.0.12.1/30"
          },
          "r1-eth3": {
            "ip": "10.0.13.1/30"
          }
        },
        "pim": {
          "rp": "10.0.0.1"
        },
        "startup": "hostname r1\n!\ninterface r1-eth2\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\ninterface r1-eth3\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\nrouter ospf\n ospf router-id 2.2.2.2\n network 10.0.0.0/24 area 0\n network 10.0.12.0/30 area 0\n network 10.0.13.0/30 area 0\n!",
        "routes": []
      }
    },
    "r2": {
      "id": 3,
      "type": "router",
      "x": 460,
      "y": 120,
      "config": {
        "daemons": [
          "ospfd",
          "pimd"
        ],
        "interfaces": {
          "r2-eth1": {
            "ip": "10.0.12.2/30"
          },
          "r2-eth2": {
            "ip": "10.0.2.1/24"
          },
          "r2-eth3": {
            "ip": "10.0.23.1/30"
          }
        },
        "pim": {
          "rp": "10.0.0.1"
        },
        "startup": "hostname r2\n!\ninterface r2-eth1\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\ninterface r2-eth3\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\nrouter ospf\n ospf router-id 3.3.3.3\n network 10.0.12.0/30 area 0\n network 10.0.2.0/24 area 0\n network 10.0.23.0/30 area 0\n!",
        "routes": []
      }
    },
    "r3": {
      "id": 4,
      "type": "router",
      "x": 460,
      "y": 360,
      "config": {
        "daemons": [
          "ospfd",
          "pimd"
        ],
        "interfaces": {
          "r3-eth1": {
            "ip": "10.0.13.2/30"
          },
          "r3-eth2": {
            "ip": "10.0.3.1/24"
          },
          "r3-eth3": {
            "ip": "10.0.23.2/30"
          }
        },
        "pim": {
          "rp": "10.0.0.1"
        },
        "startup": "hostname r3\n!\ninterface r3-eth1\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\ninterface r3-eth3\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\nrouter ospf\n ospf router-id 4.4.4.4\n network 10.0.13.0/30 area 0\n network 10.0.3.0/24 area 0\n network 10.0.23.0/30 area 0\n!",
        "routes": []
      }
    },
    "s1": {
      "id": 5,
      "type": "switch",
      "x": 640,
      "y": 120,
      "config": {
        "mode": "standalone",
        "stp": false,
        "igmp_snooping": true
      }
    },
    "s2": {
      "id": 6,
      "type": "switch",
      "x": 640,
      "y": 360,
      "config": {
        "mode": "standalone",
        "stp": false,
        "igmp_snooping": true
      }
    },
    "pc1": {
      "id": 7,
      "type": "host",
      "x": 800,
      "y": 60,
      "config": {
        "interfaces": {
          "pc1-eth1": {
            "ip": "10.0.2.11/24"
          }
        },
        "gateway": "10.0.2.1",
        "routes": []
      }
    },
    "pc2": {
      "id": 8,
      "type": "host",
      "x": 800,
      "y": 180,
      "config": {
        "interfaces": {
          "pc2-eth1": {
            "ip": "10.0.2.12/24"
          }
        },
        "gateway": "10.0.2.1",
        "routes": []
      }
    },
    "pc3": {
      "id": 9,
      "type": "host",
      "x": 800,
      "y": 360,
      "config": {
        "interfaces": {
          "pc3-eth1": {
            "ip": "10.0.3.13/24"
          }
        },
        "gateway": "10.0.3.1",
        "routes": []
      }
    }
  },
  "links": {
    "l1": {
      "a": {
        "dev": "srv1",
        "port": 1
      },
      "b": {
        "dev": "r1",
        "port": 1
      },
      "params": {
        "bw": 100,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l2": {
      "a": {
        "dev": "r1",
        "port": 2
      },
      "b": {
        "dev": "r2",
        "port": 1
      },
      "params": {
        "bw": 10,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l3": {
      "a": {
        "dev": "r1",
        "port": 3
      },
      "b": {
        "dev": "r3",
        "port": 1
      },
      "params": {
        "bw": 10,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l4": {
      "a": {
        "dev": "r2",
        "port": 3
      },
      "b": {
        "dev": "r3",
        "port": 3
      },
      "params": {
        "bw": 10,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l5": {
      "a": {
        "dev": "r2",
        "port": 2
      },
      "b": {
        "dev": "s1",
        "port": 1
      },
      "params": {
        "bw": 100,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l6": {
      "a": {
        "dev": "s1",
        "port": 2
      },
      "b": {
        "dev": "pc1",
        "port": 1
      },
      "params": {
        "bw": 100,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l7": {
      "a": {
        "dev": "s1",
        "port": 3
      },
      "b": {
        "dev": "pc2",
        "port": 1
      },
      "params": {
        "bw": 100,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l8": {
      "a": {
        "dev": "r3",
        "port": 2
      },
      "b": {
        "dev": "s2",
        "port": 1
      },
      "params": {
        "bw": 100,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l9": {
      "a": {
        "dev": "s2",
        "port": 2
      },
      "b": {
        "dev": "pc3",
        "port": 1
      },
      "params": {
        "bw": 100,
        "delay": "1ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    }
  },
  "scenarios": {
    "tv": {
      "duration": 30,
      "apps": [
        {
          "id": "tv",
          "type": "mcast",
          "src": "srv1",
          "group": "239.1.1.1",
          "dst": [
            "pc1",
            "pc3"
          ],
          "rate": "4Mbps",
          "size": 1000,
          "start": 1,
          "stop": 29,
          "label": "IPTV 239.1.1.1"
        }
      ],
      "events": [
        {
          "t": 12,
          "action": "link_down",
          "link": "l3"
        },
        {
          "t": 22,
          "action": "link_up",
          "link": "l3"
        }
      ],
      "notes": "har kabelda bitta nusxa (4 Mbit/s); pc2 portiga (l7) yuklama yo'q; t=12 da r1-r3 uziladi — pc3 shoxchasi r2-r3 (l4) orqali tiklanadi"
    }
  }
}
