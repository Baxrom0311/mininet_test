{
  "version": 1,
  "name": "reliability_lab",
  "notes": "Ishonchlilik (MTBF/MTTR): r1-r2-r3 OSPF halqasi (zaxira yo'l bor) va r3-srv2 yagona kabel (zaxirasiz). 'ishonchlilik' ssenariysi kabellarga tasodifiy nosozliklar beradi — natijada har oqim mavjudligi (availability) va kabellar ishlamay turgan vaqti; nazariy A = MTBF/(MTBF+MTTR).",
  "devices": {
    "pc1": {
      "id": 1,
      "type": "host",
      "x": 120,
      "y": 300,
      "config": {
        "interfaces": {
          "pc1-eth1": {
            "ip": "10.1.0.10/24"
          }
        },
        "gateway": "10.1.0.1",
        "routes": []
      }
    },
    "r1": {
      "id": 2,
      "type": "router",
      "x": 340,
      "y": 300,
      "config": {
        "daemons": [
          "ospfd"
        ],
        "interfaces": {
          "r1-eth1": {
            "ip": "10.1.0.1/24"
          },
          "r1-eth2": {
            "ip": "10.12.0.1/30"
          },
          "r1-eth3": {
            "ip": "10.13.0.1/30"
          }
        },
        "startup": "hostname r1\n!\ninterface r1-eth2\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\ninterface r1-eth3\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\nrouter ospf\n ospf router-id 1.1.1.1\n network 10.1.0.0/24 area 0\n network 10.12.0.0/30 area 0\n network 10.13.0.0/30 area 0\n!",
        "routes": []
      }
    },
    "r2": {
      "id": 3,
      "type": "router",
      "x": 700,
      "y": 300,
      "config": {
        "daemons": [
          "ospfd"
        ],
        "interfaces": {
          "r2-eth1": {
            "ip": "10.12.0.2/30"
          },
          "r2-eth2": {
            "ip": "10.23.0.1/30"
          },
          "r2-eth3": {
            "ip": "10.2.0.1/24"
          }
        },
        "startup": "hostname r2\n!\ninterface r2-eth1\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\ninterface r2-eth2\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\nrouter ospf\n ospf router-id 2.2.2.2\n network 10.2.0.0/24 area 0\n network 10.12.0.0/30 area 0\n network 10.23.0.0/30 area 0\n!",
        "routes": []
      }
    },
    "r3": {
      "id": 4,
      "type": "router",
      "x": 520,
      "y": 130,
      "config": {
        "daemons": [
          "ospfd"
        ],
        "interfaces": {
          "r3-eth1": {
            "ip": "10.13.0.2/30"
          },
          "r3-eth2": {
            "ip": "10.23.0.2/30"
          },
          "r3-eth3": {
            "ip": "10.3.0.1/24"
          }
        },
        "startup": "hostname r3\n!\ninterface r3-eth1\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\ninterface r3-eth2\n ip ospf network point-to-point\n ip ospf hello-interval 1\n ip ospf dead-interval 4\n!\nrouter ospf\n ospf router-id 3.3.3.3\n network 10.13.0.0/30 area 0\n network 10.23.0.0/30 area 0\n network 10.3.0.0/24 area 0\n!",
        "routes": []
      }
    },
    "srv1": {
      "id": 5,
      "type": "server",
      "x": 920,
      "y": 300,
      "config": {
        "interfaces": {
          "srv1-eth1": {
            "ip": "10.2.0.10/24"
          }
        },
        "gateway": "10.2.0.1",
        "routes": []
      }
    },
    "srv2": {
      "id": 6,
      "type": "server",
      "x": 520,
      "y": -20,
      "config": {
        "interfaces": {
          "srv2-eth1": {
            "ip": "10.3.0.10/24"
          }
        },
        "gateway": "10.3.0.1",
        "routes": []
      }
    }
  },
  "links": {
    "l1": {
      "a": {
        "dev": "pc1",
        "port": 1
      },
      "b": {
        "dev": "r1",
        "port": 1
      },
      "params": {
        "bw": 100,
        "delay": "2ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l2": {
      "a": {
        "dev": "r1",
        "port": 2
      },
      "b": {
        "dev": "r2",
        "port": 1
      },
      "params": {
        "bw": 50,
        "delay": "2ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l3": {
      "a": {
        "dev": "r1",
        "port": 3
      },
      "b": {
        "dev": "r3",
        "port": 1
      },
      "params": {
        "bw": 20,
        "delay": "5ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l4": {
      "a": {
        "dev": "r3",
        "port": 2
      },
      "b": {
        "dev": "r2",
        "port": 2
      },
      "params": {
        "bw": 20,
        "delay": "5ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l5": {
      "a": {
        "dev": "r2",
        "port": 3
      },
      "b": {
        "dev": "srv1",
        "port": 1
      },
      "params": {
        "bw": 100,
        "delay": "2ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    },
    "l6": {
      "a": {
        "dev": "r3",
        "port": 3
      },
      "b": {
        "dev": "srv2",
        "port": 1
      },
      "params": {
        "bw": 100,
        "delay": "2ms",
        "jitter": "0ms",
        "loss": 0,
        "queue": 1000
      },
      "up": true
    }
  },
  "p4_programs": {},
  "controllers": {},
  "scenarios": {
    "ishonchlilik": {
      "duration": 600,
      "notes": "core kabellar (l2,l3,l4) va zaxirasiz l6: MTBF 120 s, MTTR 15 s (eksponensial, seed 1). srv1 ga oqim zaxira yo'l tufayli deyarli doim mavjud, srv2 ga — l6 nosozliklari bilan.",
      "apps": [
        {
          "id": "core",
          "type": "udp",
          "src": "pc1",
          "dst": "srv1",
          "rate": "2Mbps",
          "size": 1000,
          "start": 1,
          "stop": 599,
          "label": "pc1→srv1 (zaxirali)"
        },
        {
          "id": "edge",
          "type": "udp",
          "src": "pc1",
          "dst": "srv2",
          "rate": "2Mbps",
          "size": 1000,
          "start": 1,
          "stop": 599,
          "label": "pc1→srv2 (l6 zaxirasiz)"
        },
        {
          "id": "ping",
          "type": "ping",
          "src": "pc1",
          "dst": "srv1",
          "interval": 1,
          "start": 1,
          "stop": 599,
          "label": "ping pc1→srv1"
        }
      ],
      "events": [],
      "failures": {
        "seed": 1,
        "distribution": "exponential",
        "links": {
          "mtbf_s": 120,
          "mttr_s": 15,
          "targets": [
            "l2",
            "l3",
            "l4",
            "l6"
          ]
        }
      }
    },
    "qisqa": {
      "duration": 60,
      "notes": "ns-3 / Mininet uchun qisqa variant (MTBF 20 s, MTTR 5 s)",
      "apps": [
        {
          "id": "core",
          "type": "udp",
          "src": "pc1",
          "dst": "srv1",
          "rate": "2Mbps",
          "size": 1000,
          "start": 1,
          "stop": 59
        },
        {
          "id": "edge",
          "type": "udp",
          "src": "pc1",
          "dst": "srv2",
          "rate": "2Mbps",
          "size": 1000,
          "start": 1,
          "stop": 59
        }
      ],
      "events": [],
      "failures": {
        "seed": 3,
        "distribution": "exponential",
        "links": {
          "mtbf_s": 20,
          "mttr_s": 5,
          "targets": [
            "l2",
            "l6"
          ]
        }
      }
    }
  }
}
